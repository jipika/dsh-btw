  },
  "homepage": "https://github.com/jipika/dsh-btw#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "slash-command",
    "side-question",
    "btw",
    "session"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "lib/index.js",
    "lib/transcript.js",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
